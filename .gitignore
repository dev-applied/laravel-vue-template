# Capacitor — platform folders are generated per-machine by `npx cap add`
# and most projects don't commit them (CI regenerates from scratch). If a
# specific project DOES want to commit them, delete the relevant line.
/ios
/android
# Capacitor build artifacts
/capacitor-cordova-ios-plugins
/capacitor-cordova-android-plugins

# Claude Code runtime state (settings.json and commands/ ARE committed)
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
.playwright*

# Per-process fixture module written by ModuleCheckCommandTest (deleted in afterEach;
# ignored so a killed process cannot leave one committable behind).
modules/__Check*
