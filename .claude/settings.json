{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose exec * php artisan *)",
      "Bash(docker compose exec * composer *)",
      "Bash(docker compose exec * ./vendor/bin/pest *)",
      "Bash(docker compose exec * ./vendor/bin/pint *)",
      "Bash(docker compose exec * npm *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose stop*)",
      "Bash(npm run lint)",
      "Bash(npm run fix)",
      "Bash(npm run type-check)",
      "Bash(npm run dev)",
      "Bash(npm run build*)",
      "Bash(npm run test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ]
  }
}
