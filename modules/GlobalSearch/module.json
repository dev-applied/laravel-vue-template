{
    "name": "GlobalSearch",
    "version": "0.1.0",
    "harvested_from": "laravel-vue-template (built generic 2026-08-25)",
    "template_version_tested": "2026-08",
    "description": "Cross-model search behind one endpoint: a project registers named search sources, and a command palette (Cmd/Ctrl+K) queries every source the user is allowed to reach, grouped by type. Needs no search engine \u2014 a source is a closure returning a builder, so the default install is plain SQL.",
    "composer_requires": [],
    "options": {
        "history": {
            "prompt": "Remember each user's recent searches?",
            "type": "select",
            "default": "per-user",
            "choices": {
                "per-user": {
                    "label": "Yes \u2014 recent searches per user (adds one table)"
                },
                "none": {
                    "label": "No \u2014 no table, no history endpoints",
                    "drop": [
                        "Models/SearchHistory.php",
                        "Database/Migrations/2026_08_25_040000_create_search_histories_table.php",
                        "Http/Controllers/SearchHistoryController.php",
                        "Routes/history.php",
                        "Tests/Feature/SearchHistoryTest.php"
                    ]
                }
            }
        },
        "scout": {
            "prompt": "Add the Laravel Scout source helper?",
            "type": "select",
            "default": "off",
            "choices": {
                "off": {
                    "label": "No \u2014 sources are plain builders (no dependency)",
                    "drop": [
                        "Support/ScoutSearchSource.php",
                        "Tests/Feature/ScoutSearchSourceTest.php"
                    ]
                },
                "on": {
                    "label": "Yes \u2014 adds laravel/scout and a helper that builds a source from a Scout model",
                    "require": [
                        "laravel/scout:^10.11"
                    ]
                }
            }
        }
    },
    "installed_from_commit": "d03a9b11d9956907e0ffb5ce7198fa6ed37fbe87",
    "installed_at": "2026-08-25",
    "installed_options": {
        "history": "per-user",
        "scout": "off"
    }
}
