#!/bin/sh

npm run fix

# `webserver` is the compose SERVICE name (see docker-compose.yml).
# It is deliberately NOT $DOCKER_ROUTER: that variable is the Traefik router
# label (traefik.http.routers.$DOCKER_ROUTER.*) and never resolves as a
# `docker compose exec` target. Using it here sent every commit down the host
# fallback, where a Docker-only machine has no php and the hook died with a
# bare `env: php: No such file or directory`.
SERVICE=webserver

CID="$(docker compose ps -q "$SERVICE" 2>/dev/null)"

if [ -n "$CID" ] && docker inspect -f '{{.State.Running}}' "$CID" 2>/dev/null | grep -q true; then
  echo "🛠  pint — docker compose service: $SERVICE"
  docker compose exec -T "$SERVICE" ./vendor/bin/pint --test --parallel || exit 1
elif command -v php >/dev/null 2>&1; then
  echo "⚙️  '$SERVICE' not running — falling back to host php"
  ./vendor/bin/pint --test --parallel || exit 1
else
  echo "✖ pre-commit: '$SERVICE' isn't running and there is no php on the host."
  echo "  Start the stack:   docker compose up -d"
  echo "  Skip this commit:  git commit --no-verify"
  exit 1
fi
