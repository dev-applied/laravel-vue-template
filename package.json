{
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-dev": "vite build --mode development",
    "build:capacitor": "vite build --mode capacitor",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "npm run build:capacitor && cap sync ios && cap run ios",
    "cap:run:android": "npm run build:capacitor && cap sync android && cap run android",
    "cap:doctor": "cap doctor",
    "lint": "cross-env NODE_ENV=production eslint resources/ts/ --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-pattern .gitignore",
    "fix": "cross-env NODE_ENV=production eslint resources/ts/ --fix --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky"
  },
  "type": "module",
